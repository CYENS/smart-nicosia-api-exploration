# Copy this file to .env (which git ignores) and fill in your key.
# Get a key at https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# Hosting (see deploy/README.md)
# CHATBOT_PASSWORD=            # puts the whole site behind this password (any username)
# DOMAIN=nicosia.example.org   # the hostname Caddy gets an HTTPS certificate for

# Optional overrides
# CHATBOT_MODEL=claude-sonnet-5-5
# CHATBOT_EFFORT=medium        # low | medium | high
# CHATBOT_PORT=8000
# CHATBOT_WEB_SEARCH=1         # 0 to turn off Claude's web search tool

# The twin's memory (docs/twin-memory.md)
# COLLECTOR_DB=data/smart_nicosia.duckdb  # the DuckDB file the chatbot and the collector share
# CHATBOT_RECORD=1             # 0 to stop keeping what the chatbot fetches in the memory
# CHATBOT_COLLECT=0            # 1 to also run the full collector here (~23,500 requests a day)
# CHATBOT_ADMIN_PASSWORD=      # unlocks changes on /admin (start, pause, cadences); unset: read only
