{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chatbot",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "chatbot"
      ],
      "port": 8000
    },
    {
      "name": "chatbot-8010",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-c",
        "import os; os.environ['CHATBOT_PORT'] = '8010'; from chatbot.server import main; main()"
      ],
      "port": 8010
    },
    {
      "name": "chatbot-8020",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-c",
        "import os; os.environ['CHATBOT_PORT'] = '8020'; from chatbot.server import main; main()"
      ],
      "port": 8020
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "chatbot/web",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "web-dev-8010",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.CHATBOT_URL = 'http://127.0.0.1:8010'; process.argv.push('vite', '--port', process.env.PORT || '5190', '--strictPort'); process.chdir('chatbot/web'); import('./chatbot/web/node_modules/vite/bin/vite.js')"
      ],
      "port": 5190
    },
